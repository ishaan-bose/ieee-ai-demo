  "openapi": "3.1.0",
  "paths": {
    "/api/dev/hello-stream": {
      "get": {
        "description": "Streams `event: tick` with data {\"count\": n, \"server_time\": unix_seconds} once per interval.",
        "operationId": "hello_stream_api_dev_hello_stream_get",
        "parameters": [
          {
            "description": "stop after this many ticks (default: forever)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100000,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "stop after this many ticks (default: forever)",
              "title": "Limit"
            }
          },
          {
            "description": "seconds between ticks",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": 1.0,
              "description": "seconds between ticks",
              "maximum": 60,
              "minimum": 0.01,
              "title": "Interval",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Hello Stream"
      }
    },
    "/api/health": {

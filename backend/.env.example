# Copy to backend/.env (gitignored) and edit. Real environment variables win over this file.
DATA_DIR=~/demo/data
STATE_DIR=~/demo/state
NUM_WORKERS=4
# Admin token for /admin routes (used from phase 6). Pick a long random string; never commit it.
ADMIN_TOKEN=change-me
# Set to 0 to skip the startup self-check.
SELF_CHECK=1

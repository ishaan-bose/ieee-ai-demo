# Copy to backend/.env (gitignored) and edit. Real environment variables win over this file.
DATA_DIR=~/demo/data
STATE_DIR=~/demo/state
LOG_DIR=~/demo/logs
NUM_WORKERS=4
# Admin token for /admin routes. Pick a long random string; never commit it. Without it the admin API is disabled.
ADMIN_TOKEN=change-me
# Set to 0 to skip the startup self-check.
SELF_CHECK=1

# Optional overrides (normally leave these alone):
# BUDGET_FLOPS and TIME_CAP_SECONDS are calibrated by scripts/benchmark.py into STATE_DIR/calibration.json;
# an environment variable here wins over that file.
# BUDGET_FLOPS=1e16
# TIME_CAP_SECONDS=1620
# CHECKPOINT_SECONDS=10
# METRICS_SECONDS=2
# VAL_ROWS=50000
# RACE_MAX_SECONDS=120
